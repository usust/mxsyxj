{
  "name": "moxi-watermark-camera",
  "version": "1.9.9",
  "description": "今日水印相机 - 本地拍照、水印、拼图与个人资料，无需后端",
  "main": "index.html",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "test": "node --test tests/*.test.cjs",
    "android:prepare": "npm run build && node scripts/prepare-android.mjs",
    "cap:sync": "npm run android:prepare",
    "android:build": "npm run android:prepare && cd android && ./gradlew assembleDebug",
    "android:release": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.64.0"
  },
  "author": "今日水印相机",
  "license": "MIT",
  "androidVersionCode": 18
}
